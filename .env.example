# Copy to .env and fill in only the values you need. Never commit .env.
#
# Hugging Face (optional for the public Wikipedia dataset; needed for the gated
# Meta Llama 2 tokenizer and/or Hugging Face Storage Bucket sync).
# HF_TOKEN is a Hugging Face user access token. It needs read access to the
# Llama 2 tokenizer; add write access if uploading to a Storage Bucket.
HF_TOKEN=
# Account username, or namespace/organization that owns the bucket.
HF_USERNAME=
HF_NAMESPACE=
# Create a Storage Bucket first. Use HF_BUCKET_ID=owner/name OR set name + owner.
HF_BUCKET_NAME=
HF_BUCKET_ID=
# Folder prefix within the bucket used for tokenizer, data, checkpoints, and logs.
HF_BUCKET_PREFIX=neuron-wikipedia

# Weights & Biases (optional experiment tracking).
# Create an API key in your W&B account settings. WANDB_ENTITY is your user/team;
# WANDB_PROJECT is the project slug. Leave WANDB_RUN_ID empty for auto creation.
WANDB_API_KEY=
WANDB_USERNAME=
WANDB_ENTITY=
WANDB_PROJECT=neuron-wikipedia-pretrain
WANDB_RUN_ID=
# online, offline, or disabled.
WANDB_MODE=online
